MONGODB_URI=mongodb://127.0.0.1:27017/studyhub
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PLATFORM_COMMISSION_PERCENT=10
# Development only: approve seller applications automatically. Leave unset in production.
AUTO_APPROVE_SELLERS=false
# Optional, used by scripts/seed.mjs to create an admin who can approve sellers
ADMIN_EMAIL=
ADMIN_PASSWORD=
